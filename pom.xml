<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Modelled on the sibling mysql-sakila-jakarta-data: Jakarta Data over an upstream persistence module, parent-less,
    the Jakarta EE 11 BOM for the APIs and Hibernate's platform BOM for the provider. The one difference is where the
    entities come from: upstream (postgres-demonstration-persistence) publishes mapped superclasses and converters,
    not entities, so the entities are this project's own, in src/main, extending those superclasses.
    -->
  <groupId>com.github.jinahya</groupId>
  <artifactId>postgresql-demodb-jakarta-data</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>${project.artifactId}</name>
  <description>Jakarta Data for the PostgreSQL Demonstration Database</description>
  <url>https://github.com/jinahya/${project.artifactId}</url>
  <inceptionYear>2026</inceptionYear>
  <organization>
    <name>Jinahya, Inc.</name>
    <url>https://jinahya.com</url>
  </organization>

  <developers>
    <developer>
      <id>onacit</id>
      <name>Kwon, Jin</name>
      <email>onacit@gmail.com</email>
      <url>https://github.com/onacit</url>
      <roles>
        <role>developer</role>
      </roles>
      <timezone>Asia/Seoul</timezone>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:git@github.com:jinahya/${project.artifactId}.git</connection>
    <developerConnection>scm:git:git@github.com:jinahya/${project.artifactId}.git</developerConnection>
    <url>https://github.com/jinahya/${project.artifactId}</url>
    <tag>HEAD</tag>
  </scm>
  <issueManagement>
    <system>GitHub Issues</system>
    <url>https://github.com/jinahya/${project.artifactId}/issues</url>
  </issueManagement>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!--
      Upstream (postgres-demonstration-persistence) compiles its main sources at release 17 and its tests at 25; 17 is
      therefore the floor for anything compiled against its mapped superclasses. Both halves here are 25, as the
      siblings.
      -->
    <maven.compiler.source>25</maven.compiler.source>
    <maven.compiler.target>${maven.compiler.source}</maven.compiler.target>
    <maven.compiler.release>${maven.compiler.target}</maven.compiler.release>
    <maven.compiler.testSource>${maven.compiler.source}</maven.compiler.testSource>
    <maven.compiler.testTarget>${maven.compiler.testSource}</maven.compiler.testTarget>
    <maven.compiler.testRelease>${maven.compiler.testSource}</maven.compiler.testRelease>
    <!--
      Keep parameter names in the class files, as upstream does. Jakarta Data binds a query method's parameters by
      their names (`@By`-less `findByStatus(String status)`, `:status` in @Query) and the processor reads them from
      source, but a consumer compiling against this jar sees them only if they are kept.
      -->
    <maven.compiler.parameters>true</maven.compiler.parameters>

    <!--
      Jakarta EE 11 is the platform generation: Jakarta Data 1.0 and Jakarta Persistence 3.2, which the upstream
      mappings are written against (upstream: jakarta.jakartaee-bom 11.0.0). The BOM manages jakarta.data-api 1.0.1.
      https://jakarta.ee/specifications/platform/11/
      https://central.sonatype.com/artifact/jakarta.platform/jakarta.jakartaee-bom/versions
      -->
    <version.jakarta.jakartaee-bom>11.0.0</version.jakarta.jakartaee-bom>

    <!--
      The one Jakarta Data provider for Java SE: Hibernate Data Repositories, i.e. hibernate-processor generating an
      implementation of every @Repository at compile time, over a StatelessSession of hibernate-core at run time.
      EclipseLink 5.0 implements Jakarta Persistence 3.2 only, no Jakarta Data, so unlike upstream there is no provider
      axis here and no provider profiles. The version is upstream's (version.org.hibernate.orm there), so the generated
      code runs on the same ORM its metamodel was generated by.
      https://hibernate.org/orm/releases/
      https://central.sonatype.com/artifact/org.hibernate.orm/hibernate-platform/versions
      https://docs.hibernate.org/orm/7.4/repositories/html_single/Hibernate_Data_Repositories.html
      -->
    <version.org.hibernate.orm>7.4.12.Final</version.org.hibernate.orm>

    <!-- Local SNAPSHOT only: `./mvnw -DskipTests install` the sibling checkout to pick up a change there. -->
    <version.postgres-demonstration-persistence>0.0.1-SNAPSHOT</version.postgres-demonstration-persistence>

    <!--
      The versions below are the ones upstream's pom names (version.* properties of the same name), so that what
      compiles here against its test-companion jar is what that jar was compiled against.
      -->
    <!-- https://central.sonatype.com/artifact/io.github.jinahya/jinahya-persistence-test-utils/versions -->
    <version.jinahya-persistence>0.6.7</version.jinahya-persistence>
    <!-- https://central.sonatype.com/artifact/uk.co.jemos.podam/podam/versions -->
    <version.uk.co.jemos.podam>8.0.2.RELEASE</version.uk.co.jemos.podam>
    <!-- https://central.sonatype.com/artifact/org.projectlombok/lombok/versions -->
    <version.org.projectlombok>1.18.48</version.org.projectlombok>
    <!-- https://jdbc.postgresql.org/ -->
    <!-- https://central.sonatype.com/artifact/org.postgresql/postgresql/versions -->
    <version.org.postgresql>42.7.14</version.org.postgresql>
    <!-- https://central.sonatype.com/artifact/com.h2database/h2/versions -->
    <version.com.h2database>2.5.252</version.com.h2database>
    <!-- https://central.sonatype.com/artifact/ch.qos.logback/logback-classic/versions -->
    <version.ch.qos.logback>1.6.5</version.ch.qos.logback>
    <!-- https://central.sonatype.com/artifact/org.slf4j/slf4j-bom/versions -->
    <version.org.slf4j>2.0.20</version.org.slf4j>
    <!-- https://central.sonatype.com/artifact/org.junit/junit-bom/versions -->
    <version.org.junit>6.1.3</version.org.junit>
    <!-- https://central.sonatype.com/artifact/org.assertj/assertj-core/versions -->
    <version.org.assertj>4.0.0-M1</version.org.assertj>
    <!-- https://central.sonatype.com/artifact/org.mockito/mockito-junit-jupiter/versions -->
    <version.org.mockito>5.24.0</version.org.mockito>
    <!-- hibernate-validator: 9 / expressly: 6 -->
    <!-- https://central.sonatype.com/artifact/org.hibernate.validator/hibernate-validator/versions -->
    <version.org.hibernate.validator>9.1.4.Final</version.org.hibernate.validator>
    <!-- https://central.sonatype.com/artifact/org.glassfish.expressly/expressly/versions -->
    <version.org.glassfish.expressly>6.0.0</version.org.glassfish.expressly>
    <!-- weld-junit5 (weld-testing) version, not the Weld version; 5.0.x pulls Weld 6 / CDI 4.1 -->
    <!-- https://central.sonatype.com/artifact/org.jboss.weld/weld-junit5/versions -->
    <version.org.jboss.weld>5.0.3.Final</version.org.jboss.weld>

    <!-- https://central.sonatype.com/artifact/org.jspecify/jspecify/versions -->
    <version.org.jspecify>1.0.1</version.org.jspecify>

    <!-- https://central.sonatype.com/artifact/org.apache.maven.plugins/maven-surefire-plugin/versions -->
    <version.maven-surefire>3.6.0</version.maven-surefire>
    <version.maven-failsafe>${version.maven-surefire}</version.maven-failsafe>

    <!-- Transitive only; pinned to PROJECTS_VERSIONS.asciidoc at the book's root. -->
    <!-- https://central.sonatype.com/artifact/io.github.jinahya/jinahya-object-randomizer/versions -->
    <version.jinahya-object-randomizer>0.0.7</version.jinahya-object-randomizer>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.github.jinahya</groupId>
        <artifactId>jinahya-object-randomizer</artifactId>
        <version>${version.jinahya-object-randomizer}</version>
      </dependency>
      <!--
        Imported, not inherited: this pom is parent-less. A direct entry below beats an imported one, and an earlier
        import beats a later one, which is how the pins that follow work: the platform BOM resolves every jakarta.*
        API, Hibernate's platform BOM everything org.hibernate.orm and what it brings.
        -->
      <dependency>
        <groupId>jakarta.platform</groupId>
        <artifactId>jakarta.jakartaee-bom</artifactId>
        <version>${version.jakarta.jakartaee-bom}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.hibernate.orm</groupId>
        <artifactId>hibernate-platform</artifactId>
        <version>${version.org.hibernate.orm}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${version.org.junit}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-bom</artifactId>
        <version>${version.org.slf4j}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- The upstream jar: the mapped superclasses, their static metamodel, and the converters. -->
      <dependency>
        <groupId>io.github.jinahya</groupId>
        <artifactId>postgres-demonstration-persistence</artifactId>
        <version>${version.postgres-demonstration-persistence}</version>
      </dependency>
      <!--
        Its randomizers and persisters, published as a second jar of the same artifact classified test-companion; a
        classifier needs an entry of its own. The jar brings none of its dependencies, so podam and
        jinahya-persistence-test-utils are declared below.
        -->
      <dependency>
        <groupId>io.github.jinahya</groupId>
        <artifactId>postgres-demonstration-persistence</artifactId>
        <version>${version.postgres-demonstration-persistence}</version>
        <classifier>test-companion</classifier>
      </dependency>

      <dependency>
        <groupId>io.github.jinahya</groupId>
        <artifactId>jinahya-persistence-utils</artifactId>
        <version>${version.jinahya-persistence}</version>
      </dependency>
      <dependency>
        <groupId>io.github.jinahya</groupId>
        <artifactId>jinahya-persistence-test-utils</artifactId>
        <version>${version.jinahya-persistence}</version>
      </dependency>
      <dependency>
        <groupId>uk.co.jemos.podam</groupId>
        <artifactId>podam</artifactId>
        <version>${version.uk.co.jemos.podam}</version>
      </dependency>

      <dependency>
        <groupId>org.jspecify</groupId>
        <artifactId>jspecify</artifactId>
        <version>${version.org.jspecify}</version>
      </dependency>
      <dependency>
        <groupId>org.projectlombok</groupId>
        <artifactId>lombok</artifactId>
        <version>${version.org.projectlombok}</version>
      </dependency>

      <dependency>
        <groupId>org.hibernate.validator</groupId>
        <artifactId>hibernate-validator</artifactId>
        <version>${version.org.hibernate.validator}</version>
      </dependency>
      <dependency>
        <groupId>org.glassfish.expressly</groupId>
        <artifactId>expressly</artifactId>
        <version>${version.org.glassfish.expressly}</version>
      </dependency>
      <dependency>
        <groupId>org.jboss.weld</groupId>
        <artifactId>weld-junit5</artifactId>
        <version>${version.org.jboss.weld}</version>
      </dependency>

      <dependency>
        <groupId>org.assertj</groupId>
        <artifactId>assertj-core</artifactId>
        <version>${version.org.assertj}</version>
      </dependency>
      <dependency>
        <groupId>org.mockito</groupId>
        <artifactId>mockito-junit-jupiter</artifactId>
        <version>${version.org.mockito}</version>
      </dependency>
      <dependency>
        <groupId>ch.qos.logback</groupId>
        <artifactId>logback-classic</artifactId>
        <version>${version.ch.qos.logback}</version>
      </dependency>

      <dependency>
        <groupId>org.postgresql</groupId>
        <artifactId>postgresql</artifactId>
        <version>${version.org.postgresql}</version>
      </dependency>
      <dependency>
        <groupId>com.h2database</groupId>
        <artifactId>h2</artifactId>
        <version>${version.com.h2database}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!--
      main =======================================================================================
      The mapped superclasses the entities of this project extend, their static metamodel (MappedFlight_, ...), and
      the converters the mappings name. Upstream keeps its own entities in its test sources, so none arrive from the
      jar; the ones here, one package up from the repositories, are copies of them. Its jakarta.* and driver
      dependencies are provided there, so none arrive transitively.
      -->
    <dependency>
      <groupId>io.github.jinahya</groupId>
      <artifactId>postgres-demonstration-persistence</artifactId>
    </dependency>
    <!--
      The API the repositories are written in. Provided: a consumer brings its own Jakarta Data, Jakarta Persistence
      and provider. jakarta.persistence-api is what the entities are mapped with.
      -->
    <dependency>
      <groupId>jakarta.data</groupId>
      <artifactId>jakarta.data-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>jakarta.persistence</groupId>
      <artifactId>jakarta.persistence-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <!--
      Bean Validation constraints on repository method parameters (@NotBlank, @Positive, ...), and the ones the
      mapped superclasses carry. The API only, provided: enforcing them takes a provider, which the application
      brings.
      -->
    <dependency>
      <groupId>jakarta.validation</groupId>
      <artifactId>jakarta.validation-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <!--
      hibernate-processor emits each repository implementation as a CDI bean, @Dependent with an @Inject constructor,
      when it sees these on the classpath; without them, a plain class whose constructor takes the StatelessSession.
      Provided, so that the generated classes are injectable under a container and the annotations cost a consumer
      without one nothing. Upstream's converters are CDI beans too, with an @Inject constructor.
      -->
    <dependency>
      <groupId>jakarta.inject</groupId>
      <artifactId>jakarta.inject-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>jakarta.enterprise</groupId>
      <artifactId>jakarta.enterprise.cdi-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <!--
      The generated implementations are written against org.hibernate.StatelessSession, so hibernate-core is a compile
      dependency of this jar, provided: the consumer runs them on its own Hibernate.
      -->
    <dependency>
      <groupId>org.hibernate.orm</groupId>
      <artifactId>hibernate-core</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- @NullMarked on the package; CLASS-retained, so a consumer needs it only to read the nullness. -->
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
      <scope>provided</scope>
    </dependency>
    <!--
      Main and test sources alike. Provided: Lombok is a compile-time tool only, so it is neither packaged nor passed
      on to consumers of this jar.
      -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- test frameworks ========================================================================== -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- A CDI container for the tests, which inject the generated repositories as upstream injects its persisters. -->
    <dependency>
      <groupId>org.jboss.weld</groupId>
      <artifactId>weld-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Hibernate Validator, and the EL it needs, to enforce the repositories' constraints in the tests. -->
    <dependency>
      <groupId>org.hibernate.validator</groupId>
      <artifactId>hibernate-validator</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.glassfish.expressly</groupId>
      <artifactId>expressly</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      test runtime ===============================================================================
      The driver for the demonstration database upstream brings up (compose.yaml there; localhost:5432/demo), and the
      H2 (MODE=PostgreSQL) the unit tests run on. Test scope, so consumers get neither.
      -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- test tools ================================================================================= -->
    <!-- The upstream randomizers and persisters. -->
    <dependency>
      <groupId>io.github.jinahya</groupId>
      <artifactId>postgres-demonstration-persistence</artifactId>
      <classifier>test-companion</classifier>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.jinahya</groupId>
      <artifactId>jinahya-persistence-utils</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.jinahya</groupId>
      <artifactId>jinahya-persistence-test-utils</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- What the upstream randomizers fill instances with. -->
    <dependency>
      <groupId>uk.co.jemos.podam</groupId>
      <artifactId>podam</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <!-- https://central.sonatype.com/artifact/org.apache.maven.plugins/maven-compiler-plugin/versions -->
          <version>3.16.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <!-- https://central.sonatype.com/artifact/org.apache.maven.plugins/maven-enforcer-plugin/versions -->
          <version>3.6.3</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${version.maven-surefire}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>${version.maven-failsafe}</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <!--
        Two processors on the processor path of both executions, default-compile and default-testCompile: Lombok, and
        hibernate-processor, which generates the static metamodel of the entities of the main sources (Flight_, ...,
        each extending upstream's MappedFlight_) and implements every @Repository interface as a <Name>_ class, both
        under target/generated-sources/annotations. Each <path> takes its version from dependencyManagement
        (annotationProcessorPathsUseDepMgmt), so the processor and the hibernate-core it generates against stay in
        step.
        -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPathsUseDepMgmt>true</annotationProcessorPathsUseDepMgmt>
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </path>
            <path>
              <groupId>org.hibernate.orm</groupId>
              <artifactId>hibernate-processor</artifactId>
            </path>
          </annotationProcessorPaths>
          <compilerArgs>
            <arg>-Xlint</arg>
            <!--
              The processor also writes a Jakarta Data metamodel per entity (_Flight, ...), each extending the one of
              its mapped superclass (_MappedFlight), which upstream, compiled without jakarta.data, never generated.
              The repositories are generated against the Jakarta Persistence metamodel (Flight_, MappedFlight_), so
              that second metamodel is left out.
              -->
            <arg>-AsuppressJakartaDataMetamodel=true</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <!--
        Dependency convergence is a build defect, not a warning, as upstream treats it. Resolve jakarta.* at the
        platform level (the BOMs above) instead of pinning individual API artifacts.
        -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-dependency-convergence</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <dependencyConvergence/>
              </rules>
            </configuration>
          </execution>
          <execution>
            <!-- The build JDK: the compiler release above is 25. -->
            <id>enforce-require-java-version</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[25,)</version>
                </requireJavaVersion>
              </rules>
            </configuration>
          </execution>
          <execution>
            <!--
              A -P naming a profile that does not exist is silently ignored by Maven; this turns that into a build
              failure. The _mvn_*.sh scripts name `failsafe`, so a rename that missed one of them would otherwise just
              skip the ITs and look green.
              -->
            <id>enforce-require-profile-ids-exist</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireProfileIdsExist/>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <skipAfterFailureCount>1</skipAfterFailureCount>
          <trimStackTrace>false</trimStackTrace>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      Binds maven-failsafe-plugin, which runs the *IT classes against the demonstration database upstream's
      _docker_compose_up.sh brings up. A profile, as upstream, so that a plain `mvnw verify` needs no database.
      -->
    <profile>
      <id>failsafe</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <executions>
              <execution>
                <goals>
                  <goal>integration-test</goal>
                  <goal>verify</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <includes>
                <include>**/*IT.java</include>
              </includes>
              <skipAfterFailureCount>1</skipAfterFailureCount>
              <trimStackTrace>false</trimStackTrace>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
